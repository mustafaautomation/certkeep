# Certkeep local overrides. Every variable is optional.
# With none of these set, the app runs in mock mode.

# Session signing. Defaults to a public demo key when unset.
SESSION_SECRET=

# Supabase Auth, Postgres, and Storage. Apply supabase/migrations first.
# The running app keeps the mock vault until these are wired in a later pass.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode. When both the secret and a price are set, checkout redirects to Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Certificate extraction. The sample PDF is parsed locally when these are empty.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
